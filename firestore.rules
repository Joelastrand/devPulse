rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // teams holds admin-managed team metadata (name, active/disabled
    // status). All access happens server-side via the Firebase Admin SDK
    // (src/features/teams/server/), which bypasses these rules entirely —
    // this rule exists solely to deny the separate client-SDK path
    // unconditionally, regardless of authentication state (including an
    // app admin's) — every collection in this file carries the same
    // documentation/defense-in-depth deny block, for the same reason. See
    // docs/features/team-management/SPEC.md (BR-35).
    match /teams/{document=**} {
      allow read, write: if false;
    }

    // teamMemberships links a Firebase uid to a teamId, for authorization.
    // Same server-only-access rationale as teams above — all access
    // happens via src/features/teams/server/ using the Admin SDK. See
    // docs/features/team-management/SPEC.md (BR-35).
    match /teamMemberships/{document=**} {
      allow read, write: if false;
    }

    // teamInvitations holds pending, admin-issued, email-addressed
    // invitations, resolved server-side into a teamMemberships document.
    // Same server-only-access rationale as teams/teamMemberships above —
    // all access happens via src/features/teams/server/ using the Admin
    // SDK. See docs/features/team-management/SPEC.md (BR-35).
    match /teamInvitations/{document=**} {
      allow read, write: if false;
    }

    // teamAccessRequests holds a non-member's in-app request to join a
    // team, resolved server-side (approve creates a teamMemberships
    // document; reject creates none). Same server-only-access rationale
    // as teams/teamMemberships/teamInvitations above — all access happens
    // via src/features/teams/server/ using the Admin SDK. See
    // docs/features/team-management/SPEC.md (BR-35).
    match /teamAccessRequests/{document=**} {
      allow read, write: if false;
    }

    // surveys holds admin-managed survey instances (teamId, accessMode,
    // optional title/startAt/endAt, lifecycle timestamps, createdAt,
    // createdBy). All access happens server-side via the Firebase Admin SDK
    // (src/features/surveys/server/), which bypasses these rules entirely —
    // this rule exists solely to deny the separate client-SDK path
    // unconditionally, regardless of authentication state (including an
    // app admin's), for the same documentation/defense-in-depth reason as
    // teams above. See docs/features/managed-surveys/SPEC.md (TASK-002).
    match /surveys/{document=**} {
      allow read, write: if false;
    }

    // teamSurveyState is the write-side-only coordination document
    // enforcing "at most one genuinely open survey per team"
    // (docs/features/managed-surveys/SPEC.md — "One open survey per
    // team"), read and written exclusively inside openSurvey's/
    // closeSurvey's Firestore transactions
    // (src/features/surveys/server/open-survey.ts). Same server-only-
    // access rationale as surveys above.
    match /teamSurveyState/{document=**} {
      allow read, write: if false;
    }

    // surveyResponses holds anonymous, encrypted survey answers (surveyId,
    // teamId, ciphertext, iv, authTag, keyVersion, submittedAt) — no
    // identity field, for either access mode. All access happens
    // server-side via the Firebase Admin SDK
    // (src/features/surveys/server/submit-survey-response.ts), which
    // bypasses these rules entirely — this rule exists solely to deny the
    // separate client-SDK path unconditionally, regardless of
    // authentication state (including an app admin's). Same
    // server-only-access rationale as every other collection above. See
    // docs/features/managed-surveys/SPEC.md (TASK-006).
    match /surveyResponses/{document=**} {
      allow read, write: if false;
    }

    // surveyParticipations links a Firebase uid to a surveyId, used only to
    // detect a second accepted `authenticated`-mode submission from the
    // same identity (BR-21/BR-22) — deliberately minimal ({uid, surveyId}
    // only, no submittedAt) and never joined to a specific surveyResponses
    // document by this application (BR-18). Same server-only-access
    // rationale as surveyResponses above. See docs/features/
    // managed-surveys/SPEC.md (TASK-006).
    match /surveyParticipations/{document=**} {
      allow read, write: if false;
    }

    // challenges holds anonymous, encrypted free-text challenges (teamId,
    // ciphertext, iv, authTag, keyVersion, submittedAt, plus admin-only
    // resolvedAt/resolvedBy/archivedAt/archivedBy) — no submitter identity
    // field of any kind, for any submitter. All access happens server-side
    // via the Firebase Admin SDK (src/features/challenges/server/), which
    // bypasses these rules entirely — this rule exists solely to deny the
    // separate client-SDK path unconditionally, regardless of
    // authentication state (including an app admin's). Same
    // server-only-access rationale as every other collection above. See
    // docs/features/anonymous-challenges/SPEC.md (TASK-002).
    match /challenges/{document=**} {
      allow read, write: if false;
    }

    // forumThreads holds attributed, encrypted, team-scoped discussion
    // threads (teamId, authorUid, ciphertext, iv, authTag, keyVersion,
    // createdAt) — a thread has no tombstone/soft-delete shape at all;
    // deletion is a genuine document removal (docs/features/team-forum/
    // SPEC.md — "Data model", "Lifecycle/moderation"). All access happens
    // server-side via the Firebase Admin SDK (src/features/forum/server/),
    // which bypasses these rules entirely — this rule exists solely to deny
    // the separate client-SDK path unconditionally, regardless of
    // authentication state (including an app admin's). Same
    // server-only-access rationale as every other collection above. See
    // docs/features/team-forum/SPEC.md (BR-33, TASK-002).
    match /forumThreads/{document=**} {
      allow read, write: if false;
    }

    // forumReplies holds attributed, encrypted, flat replies to a
    // forumThreads document (teamId, threadId, authorUid, ciphertext, iv,
    // authTag, keyVersion, createdAt while active). Deleting a single reply
    // (outside a thread's own cascade) leaves a content-erasing tombstone —
    // teamId, threadId, createdAt, deletedAt, deletedBy only — rather than a
    // hard delete, solely to preserve its position in the reply list
    // (docs/features/team-forum/SPEC.md — "Data model",
    // "Lifecycle/moderation"). All access happens server-side via the
    // Firebase Admin SDK (src/features/forum/server/), which bypasses these
    // rules entirely — this rule exists solely to deny the separate
    // client-SDK path unconditionally, regardless of authentication state
    // (including an app admin's). Same server-only-access rationale as every
    // other collection above. See docs/features/team-forum/SPEC.md (BR-33,
    // TASK-003).
    match /forumReplies/{document=**} {
      allow read, write: if false;
    }

    // skillTrees holds admin-defined, org-wide capability progressions
    // (name, an ordered/count/identity-immutable nodes array, createdAt/
    // createdBy, optional updatedAt/updatedBy after a cosmetic correction).
    // Not sensitive/free text beyond a short admin-authored name/label. All
    // access happens server-side via the Firebase Admin SDK
    // (src/features/skill-trees/server/), which bypasses these rules
    // entirely — this rule exists solely to deny the separate client-SDK
    // path unconditionally, regardless of authentication state (including
    // an app admin's). Same server-only-access rationale as every other
    // collection above. See docs/features/team-skill-tree/SPEC.md
    // (TASK-002).
    match /skillTrees/{document=**} {
      allow read, write: if false;
    }

    // skillProgress holds exactly one team's tracking record against
    // exactly one SkillTree (teamId, treeId, currentNodeId, updatedAt,
    // updatedBy), keyed by the deterministic id `{teamId}__{treeId}` — never
    // a person's data (docs/features/team-skill-tree/SPEC.md — "Purpose").
    // All access happens server-side via the Firebase Admin SDK
    // (src/features/skill-trees/server/), which bypasses these rules
    // entirely — this rule exists solely to deny the separate client-SDK
    // path unconditionally, regardless of authentication state (including
    // an app admin's). Same server-only-access rationale as every other
    // collection above. See docs/features/team-skill-tree/SPEC.md
    // (TASK-003).
    match /skillProgress/{document=**} {
      allow read, write: if false;
    }

    // Deny everything else by default; no collection is currently intended
    // to be reached directly by the Firebase client SDK.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
