rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // teams holds admin-managed team metadata (name, active/disabled
    // status). All access happens server-side via the Firebase Admin SDK
    // (src/features/teams/server/), which bypasses these rules entirely —
    // this rule exists solely to deny the separate client-SDK path
    // unconditionally, regardless of authentication state (including an
    // app admin's) — every collection in this file carries the same
    // documentation/defense-in-depth deny block, for the same reason. See
    // docs/archive/features/team-management/SPEC.md (BR-35).
    match /teams/{document=**} {
      allow read, write: if false;
    }

    // teamMemberships links a Firebase uid to a teamId, for authorization.
    // Same server-only-access rationale as teams above — all access
    // happens via src/features/teams/server/ using the Admin SDK. See
    // docs/archive/features/team-management/SPEC.md (BR-35).
    match /teamMemberships/{document=**} {
      allow read, write: if false;
    }

    // teamInvitations holds pending, admin-issued, email-addressed
    // invitations, resolved server-side into a teamMemberships document.
    // Same server-only-access rationale as teams/teamMemberships above —
    // all access happens via src/features/teams/server/ using the Admin
    // SDK. See docs/archive/features/team-management/SPEC.md (BR-35).
    match /teamInvitations/{document=**} {
      allow read, write: if false;
    }

    // teamAccessRequests holds a non-member's in-app request to join a
    // team, resolved server-side (approve creates a teamMemberships
    // document; reject creates none). Same server-only-access rationale
    // as teams/teamMemberships/teamInvitations above — all access happens
    // via src/features/teams/server/ using the Admin SDK. See
    // docs/archive/features/team-management/SPEC.md (BR-35).
    match /teamAccessRequests/{document=**} {
      allow read, write: if false;
    }

    // surveys holds admin-managed survey instances (teamId, accessMode,
    // optional title/startAt/endAt, lifecycle timestamps, createdAt,
    // createdBy). All access happens server-side via the Firebase Admin SDK
    // (src/features/surveys/server/), which bypasses these rules entirely —
    // this rule exists solely to deny the separate client-SDK path
    // unconditionally, regardless of authentication state (including an
    // app admin's), for the same documentation/defense-in-depth reason as
    // teams above. See docs/archive/features/managed-surveys/SPEC.md (TASK-002).
    match /surveys/{document=**} {
      allow read, write: if false;
    }

    // teamSurveyState is the write-side-only coordination document
    // enforcing "at most one genuinely open survey per team"
    // (docs/archive/features/managed-surveys/SPEC.md — "One open survey per
    // team"), read and written exclusively inside openSurvey's/
    // closeSurvey's Firestore transactions
    // (src/features/surveys/server/open-survey.ts). Same server-only-
    // access rationale as surveys above.
    match /teamSurveyState/{document=**} {
      allow read, write: if false;
    }

    // surveyResponses holds anonymous, encrypted survey answers (surveyId,
    // teamId, ciphertext, iv, authTag, keyVersion, submittedAt) — no
    // identity field, for either access mode. All access happens
    // server-side via the Firebase Admin SDK
    // (src/features/surveys/server/submit-survey-response.ts), which
    // bypasses these rules entirely — this rule exists solely to deny the
    // separate client-SDK path unconditionally, regardless of
    // authentication state (including an app admin's). Same
    // server-only-access rationale as every other collection above. See
    // docs/archive/features/managed-surveys/SPEC.md (TASK-006).
    match /surveyResponses/{document=**} {
      allow read, write: if false;
    }

    // surveyParticipations links a Firebase uid to a surveyId, used only to
    // detect a second accepted `authenticated`-mode submission from the
    // same identity (BR-21/BR-22) — deliberately minimal ({uid, surveyId}
    // only, no submittedAt) and never joined to a specific surveyResponses
    // document by this application (BR-18). Same server-only-access
    // rationale as surveyResponses above. See docs/archive/features/
    // managed-surveys/SPEC.md (TASK-006).
    match /surveyParticipations/{document=**} {
      allow read, write: if false;
    }

    // challenges holds anonymous, encrypted free-text challenges (teamId,
    // ciphertext, iv, authTag, keyVersion, submittedAt, plus admin-only
    // resolvedAt/resolvedBy/archivedAt/archivedBy) — no submitter identity
    // field of any kind, for any submitter. All access happens server-side
    // via the Firebase Admin SDK (src/features/challenges/server/), which
    // bypasses these rules entirely — this rule exists solely to deny the
    // separate client-SDK path unconditionally, regardless of
    // authentication state (including an app admin's). Same
    // server-only-access rationale as every other collection above. See
    // docs/archive/features/anonymous-challenges/SPEC.md (TASK-002).
    match /challenges/{document=**} {
      allow read, write: if false;
    }

    // forumThreads holds attributed, encrypted, team-scoped discussion
    // threads (teamId, authorUid, ciphertext, iv, authTag, keyVersion,
    // createdAt) — a thread has no tombstone/soft-delete shape at all;
    // deletion is a genuine document removal (docs/archive/features/team-forum/
    // SPEC.md — "Data model", "Lifecycle/moderation"). All access happens
    // server-side via the Firebase Admin SDK (src/features/forum/server/),
    // which bypasses these rules entirely — this rule exists solely to deny
    // the separate client-SDK path unconditionally, regardless of
    // authentication state (including an app admin's). Same
    // server-only-access rationale as every other collection above. See
    // docs/archive/features/team-forum/SPEC.md (BR-33, TASK-002).
    match /forumThreads/{document=**} {
      allow read, write: if false;
    }

    // forumReplies holds attributed, encrypted, flat replies to a
    // forumThreads document (teamId, threadId, authorUid, ciphertext, iv,
    // authTag, keyVersion, createdAt while active). Deleting a single reply
    // (outside a thread's own cascade) leaves a content-erasing tombstone —
    // teamId, threadId, createdAt, deletedAt, deletedBy only — rather than a
    // hard delete, solely to preserve its position in the reply list
    // (docs/archive/features/team-forum/SPEC.md — "Data model",
    // "Lifecycle/moderation"). All access happens server-side via the
    // Firebase Admin SDK (src/features/forum/server/), which bypasses these
    // rules entirely — this rule exists solely to deny the separate
    // client-SDK path unconditionally, regardless of authentication state
    // (including an app admin's). Same server-only-access rationale as every
    // other collection above. See docs/archive/features/team-forum/SPEC.md (BR-33,
    // TASK-003).
    match /forumReplies/{document=**} {
      allow read, write: if false;
    }

    // skillTrees holds admin-defined, org-wide capability progressions
    // (name, an ordered/count/identity-immutable nodes array, createdAt/
    // createdBy, optional updatedAt/updatedBy after a cosmetic correction).
    // Not sensitive/free text beyond a short admin-authored name/label. All
    // access happens server-side via the Firebase Admin SDK
    // (src/features/skill-trees/server/), which bypasses these rules
    // entirely — this rule exists solely to deny the separate client-SDK
    // path unconditionally, regardless of authentication state (including
    // an app admin's). Same server-only-access rationale as every other
    // collection above. See docs/archive/features/team-skill-tree/SPEC.md
    // (TASK-002).
    match /skillTrees/{document=**} {
      allow read, write: if false;
    }

    // skillProgress holds exactly one team's tracking record against
    // exactly one SkillTree (teamId, treeId, currentNodeId, updatedAt,
    // updatedBy), keyed by the deterministic id `{teamId}__{treeId}` — never
    // a person's data (docs/archive/features/team-skill-tree/SPEC.md — "Purpose").
    // All access happens server-side via the Firebase Admin SDK
    // (src/features/skill-trees/server/), which bypasses these rules
    // entirely — this rule exists solely to deny the separate client-SDK
    // path unconditionally, regardless of authentication state (including
    // an app admin's). Same server-only-access rationale as every other
    // collection above. See docs/archive/features/team-skill-tree/SPEC.md
    // (TASK-003).
    match /skillProgress/{document=**} {
      allow read, write: if false;
    }

    // roadmapItems holds exactly one team's plan for exactly one competency
    // area (teamId, treeId, targetNodeId, priority, status, optional dates
    // and ownerRef, archive/completion/audit fields), keyed by the
    // deterministic id `{teamId}__{treeId}` — a uniqueness mechanism only,
    // never authorization. Team planning metadata; no person data beyond the
    // opaque ownerRef. All access happens server-side via the Firebase Admin
    // SDK, which bypasses these rules entirely — this rule exists solely to
    // deny the separate client-SDK path unconditionally, regardless of
    // authentication state (including an app admin's). Same server-only-access
    // rationale as every other collection above. See
    // docs/archive/features/team-skill-planning/SPEC.md (TASK-004).
    match /roadmapItems/{document=**} {
      allow read, write: if false;
    }

    // teamProjects holds team-scoped delivery projects (docs/archive/features/team-experience-redesign
    // SPEC — AD-1, BR-6). Server-only via the Admin SDK in src/features/team-projects/server/;
    // the deny rule covers the client-SDK path unconditionally, as for every collection above.
    match /teamProjects/{document=**} {
      allow read, write: if false;
    }

    // teamProjectParticipations holds planned member-to-project intervals (TASK-004, BR-8). Server-only via the Admin SDK
    // in src/features/team-projects/server/; deny-only for the client SDK, as for every collection above.
    match /teamProjectParticipations/{document=**} {
      allow read, write: if false;
    }


    // teamCompetencePlans holds a team's development plan (BR-15, independent of any competence area): team-level planning
    // state (title, target stage, priority, milestones), no uid or rating. Server-only via the Admin SDK; deny-only for the client SDK.
    match /teamCompetencePlans/{document=**} {
      allow read, write: if false;
    }



    // userProfiles holds one self-set display name per Firebase uid
    // (document id = uid; displayName, createdAt, updatedAt — no e-mail or
    // other identity field). It is personal data, read/written only by the
    // owner's own server-side operations (src/features/profiles/server/)
    // via the Firebase Admin SDK, which bypasses these rules entirely — this
    // rule exists solely to deny the separate client-SDK path
    // unconditionally, regardless of authentication state (including an app
    // admin's). Same server-only-access rationale as every other collection
    // above. See docs/archive/features/member-identity-and-team-roles/SPEC.md
    // (TASK-001).
    match /userProfiles/{document=**} {
      allow read, write: if false;
    }

    // skillProfiles holds one person's private skill self-assessment
    // (document id = uid; per-skill levels, timestamps). It is personal data,
    // read/written only by the owner's own server-side operations
    // (src/features/skill-profiles/server/) via the Firebase Admin SDK, which
    // bypasses these rules entirely — this rule exists solely to deny the
    // separate client-SDK path unconditionally, regardless of authentication
    // state (including the owner's, a team lead's and an app admin's). Same
    // server-only-access rationale as every other collection above. See
    // docs/archive/features/individual-skill-self-assessment/SPEC.md (BR-36, TASK-006).
    match /skillProfiles/{document=**} {
      allow read, write: if false;
    }

    // teamSkillNeeds holds exactly one team's required level and required
    // coverage for exactly one SkillTree (teamId, treeId, requiredLevel,
    // requiredCoverage, createdAt, updatedAt — no actor or person data),
    // keyed by the deterministic id `{teamId}__{treeId}` — a uniqueness
    // mechanism only, never authorization. All access happens server-side
    // via the Firebase Admin SDK, which bypasses these rules entirely —
    // this rule exists solely to deny the separate client-SDK path
    // unconditionally, regardless of authentication state (including a
    // team member's, a team lead's and an app admin's). Same
    // server-only-access rationale as every other collection above. See
    // docs/archive/features/team-skill-needs-and-matrix/SPEC.md (BR-35, TASK-003).
    match /teamSkillNeeds/{document=**} {
      allow read, write: if false;
    }

    // roleDefinitions holds org-wide organizational role definitions: a title
    // (name), optional description, createdAt/createdBy, optional
    // updatedAt/updatedBy/archivedAt/archivedBy. No skill requirements. Written only by app admins
    // and read by signed-in people through server-side routes, all via the
    // Firebase Admin SDK (src/features/role-profiles/server/), which bypasses
    // these rules entirely. This rule exists solely to deny the separate
    // client-SDK path unconditionally, regardless of authentication state
    // (including an app admin's). Same server-only-access rationale as every
    // other collection above. See docs/archive/features/role-profiles/SPEC.md (BR-1,
    // AD-1).
    match /roleDefinitions/{document=**} {
      allow read, write: if false;
    }

    // userDevelopment holds one person's private development goals at
    // userDevelopment/{uid}/goals/{goalId} (no parent document is ever
    // created). It is personal data, read/written only by the owner's own
    // server-side operations (src/features/personal-goals/server/) via the
    // Firebase Admin SDK, which bypasses these rules entirely — this rule
    // exists solely to deny the separate client-SDK path unconditionally,
    // for the parent path, the goals subcollection and every descendant,
    // regardless of authentication state (including the owner's, a team
    // lead's and an app admin's). It is defence in depth, not the owner
    // authorization mechanism. See docs/archive/features/personal-development-goals/
    // SPEC.md (BR-44, TASK-002).
    match /userDevelopment/{document=**} {
      allow read, write: if false;
    }

    // accountErasures/{uid} is the account-erasure fence record: its status
    // is read inside every person-owned write transaction, so a client must
    // never read or write it. It holds no personal content, only status,
    // step and timestamps. Server-only access via the Firebase Admin SDK
    // (src/features/account-erasure/server/), which bypasses these rules. See
    // docs/archive/features/account-erasure/SPEC.md (BR-4, AE-SI-5).
    match /accountErasures/{document=**} {
      allow read, write: if false;
    }

    // Superadmin registry (src/features/superadmins/). Authority for global administration: Admin SDK only, so client
    // writes and reads are denied. The catch-all below would deny these anyway; the explicit rule documents the intent.
    match /superadmins/{document=**} {
      allow read, write: if false;
    }
    match /superadminRegistry/{document=**} {
      allow read, write: if false;
    }

    // Team-owned skill definitions (docs/archive/features/team-owned-skills/SPEC.md §3.1) and per-skill private self-assessments
    // (§3.2). Server-only via the Admin SDK (src/features/team-owned-skills/server/), which bypasses these rules. The
    // explicit denies document that team administrators never read individual assessments through any client path.
    match /teamSkills/{document=**} {
      allow read, write: if false;
    }
    match /teamSkillAssessments/{document=**} {
      allow read, write: if false;
    }
    // Collaborative (agreed) team level per canonical team skill (docs/archive/features/team-owned-skills/SPEC.md §12). Team-level
    // value only, server-only; no client path reads or writes it.
    match /teamManualAssessments/{document=**} {
      allow read, write: if false;
    }

    // Formal organizational role assignment: one document per user (roleAssignments/{uid}, docs/archive/features/role-profiles/
    // SPEC.md). Written only by app admins and read by the assigned person through server routes, all via the Admin SDK
    // (src/features/role-profiles/server/role-assignments.ts), which bypasses these rules. The explicit deny keeps direct
    // client access closed for admins, the assigned person and every other signed-in user. An assignment grants no
    // application permission.
    match /roleAssignments/{document=**} {
      allow read, write: if false;
    }

    // Deny everything else by default; no collection is currently intended
    // to be reached directly by the Firebase client SDK.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
