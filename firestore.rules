rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // pulseSurveyResponses holds encrypted wellbeing survey responses. All
    // access happens server-side via the Firebase Admin SDK
    // (src/lib/firebase/admin.ts), which bypasses these rules entirely —
    // this rule exists solely to deny the separate, unrelated client-SDK
    // path (src/lib/firebase/client.ts is Auth-only and never touches
    // Firestore) unconditionally, regardless of authentication state. See
    // docs/SECURITY.md invariants 8-11 and
    // docs/features/results-dashboard/SPEC.md.
    match /pulseSurveyResponses/{document=**} {
      allow read, write: if false;
    }

    // Deny everything else by default; no collection is currently intended
    // to be reached directly by the Firebase client SDK.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
